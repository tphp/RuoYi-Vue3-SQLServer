<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysApiKeyMapper">
    
    <resultMap type="SysApiKey" id="SysApiKeyResult">
        <id     property="id"          column="id"           />
        <result property="appName"     column="app_name"     />
        <result property="apiKey"      column="api_key"      />
        <result property="apiSecret"   column="api_secret"   />
        <result property="status"      column="status"       />
        <result property="expireTime"  column="expire_time"  />
        <result property="remark"      column="remark"       />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
    </resultMap>
    
    <sql id="selectApiKeyVo">
        select id, app_name, api_key, api_secret, status, expire_time, remark, create_by, create_time, update_by, update_time 
        from sys_api_key
    </sql>
    
    <select id="selectApiKeyList" parameterType="SysApiKey" resultMap="SysApiKeyResult">
        <include refid="selectApiKeyVo"/>
        <where>
            <if test="appName != null and appName != ''">
                AND app_name like concat('%', #{appName}, '%')
            </if>
            <if test="apiKey != null and apiKey != ''">
                AND api_key = #{apiKey}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectApiKeyById" parameterType="Long" resultMap="SysApiKeyResult">
        <include refid="selectApiKeyVo"/>
        where id = #{id}
    </select>
    
    <select id="selectApiKeyByKey" parameterType="String" resultMap="SysApiKeyResult">
        <include refid="selectApiKeyVo"/>
        where api_key = #{apiKey}
    </select>
    
    <insert id="insertApiKey" parameterType="SysApiKey" useGeneratedKeys="true" keyProperty="id">
        insert into sys_api_key (
            <if test="appName != null and appName != ''">app_name,</if>
            <if test="apiKey != null and apiKey != ''">api_key,</if>
            <if test="apiSecret != null and apiSecret != ''">api_secret,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="expireTime != null">expire_time,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        ) values (
            <if test="appName != null and appName != ''">#{appName},</if>
            <if test="apiKey != null and apiKey != ''">#{apiKey},</if>
            <if test="apiSecret != null and apiSecret != ''">#{apiSecret},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="expireTime != null">#{expireTime},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            getdate()
        )
    </insert>
    
    <update id="updateApiKey" parameterType="SysApiKey">
        update sys_api_key
        <set>
            <if test="appName != null and appName != ''">app_name = #{appName},</if>
            <if test="apiKey != null and apiKey != ''">api_key = #{apiKey},</if>
            <if test="apiSecret != null and apiSecret != ''">api_secret = #{apiSecret},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="expireTime != null">expire_time = #{expireTime},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = getdate()
        </set>
        where id = #{id}
    </update>
    
    <delete id="deleteApiKeyById" parameterType="Long">
        delete from sys_api_key where id = #{id}
    </delete>
    
    <delete id="deleteApiKeyByIds" parameterType="Long">
        delete from sys_api_key where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>
