<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysNumberRuleMapper">
    
    <resultMap type="SysNumberRule" id="SysNumberRuleResult">
        <id     property="ruleId"        column="rule_id"       />
        <result property="ruleName"      column="rule_name"     />
        <result property="ruleCode"      column="rule_code"     />
        <result property="description"   column="description"   />
        <result property="status"        column="status"        />
        <result property="remark"        column="remark"        />
        <result property="createBy"      column="create_by"     />
        <result property="createTime"    column="create_time"   />
        <result property="updateBy"      column="update_by"     />
        <result property="updateTime"    column="update_time"   />
    </resultMap>
    
    <sql id="selectNumberRuleVo">
        select rule_id, rule_name, rule_code, description, status, remark, create_by, create_time, update_by, update_time 
        from sys_number_rule
    </sql>
    
    <sql id="selectNumberRuleVoTop1">
        select top 1 rule_id, rule_name, rule_code, description, status, remark, create_by, create_time, update_by, update_time 
        from sys_number_rule
    </sql>
    
    <select id="selectNumberRuleList" parameterType="SysNumberRule" resultMap="SysNumberRuleResult">
        <include refid="selectNumberRuleVo"/>
        <where>
            <if test="ruleName != null and ruleName != ''">
                AND rule_name like concat('%', #{ruleName}, '%')
            </if>
            <if test="ruleCode != null and ruleCode != ''">
                AND rule_code like concat('%', #{ruleCode}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectNumberRuleById" parameterType="Long" resultMap="SysNumberRuleResult">
        <include refid="selectNumberRuleVo"/>
        where rule_id = #{ruleId}
    </select>
    
    <select id="selectNumberRuleByCode" parameterType="String" resultMap="SysNumberRuleResult">
        <include refid="selectNumberRuleVoTop1"/>
        where rule_code = #{ruleCode} and status = '0'
    </select>
    
    <select id="checkRuleCodeUnique" parameterType="String" resultMap="SysNumberRuleResult">
        <include refid="selectNumberRuleVoTop1"/>
        where rule_code = #{ruleCode}
    </select>
    
    <insert id="insertNumberRule" parameterType="SysNumberRule" useGeneratedKeys="true" keyProperty="ruleId">
        insert into sys_number_rule (
            <if test="ruleName != null and ruleName != ''">rule_name,</if>
            <if test="ruleCode != null and ruleCode != ''">rule_code,</if>
            <if test="description != null and description != ''">description,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null and remark != ''">remark,</if>
            create_time
        ) values (
            <if test="ruleName != null and ruleName != ''">#{ruleName},</if>
            <if test="ruleCode != null and ruleCode != ''">#{ruleCode},</if>
            <if test="description != null and description != ''">#{description},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            getdate()
        )
    </insert>
    
    <update id="updateNumberRule" parameterType="SysNumberRule">
        update sys_number_rule
        <set>
            <if test="ruleName != null and ruleName != ''">rule_name = #{ruleName},</if>
            <if test="ruleCode != null and ruleCode != ''">rule_code = #{ruleCode},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = getdate()
        </set>
        where rule_id = #{ruleId}
    </update>
    
    <delete id="deleteNumberRuleById" parameterType="Long">
        delete from sys_number_rule where rule_id = #{ruleId}
    </delete>
    
    <delete id="deleteNumberRuleByIds" parameterType="Long">
        delete from sys_number_rule where rule_id in 
        <foreach item="ruleId" collection="array" open="(" separator="," close=")">
            #{ruleId}
        </foreach>
    </delete>
    
</mapper>
